{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ATM (modern)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/atm.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": true,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/Program Files/gcc/mingw64/bin/gdb.exe",
      "preLaunchTask": "build-atm",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
